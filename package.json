{
  "name": "stellar-review-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Patient review and private feedback portal for Stellar Dental Clinic",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:engine && npm run build:app",
    "build:app": "npm run build -w shared && npm run build -w server && npm run build -w web",
    "build:engine": "make -C sentiment-engine",
    "start": "node --env-file-if-exists=.env server/dist/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/dist/cli/migrate.js",
    "admin:create": "node --env-file-if-exists=.env server/dist/cli/createUser.js",
    "retention:purge": "node --env-file-if-exists=.env server/dist/cli/purge.js",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p web --noEmit && tsc -p e2e --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
