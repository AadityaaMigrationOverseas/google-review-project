# Stellar Dental Clinic review portal configuration.
# Copy to .env and fill in. Never commit real secrets; in production prefer your
# platform's secret store (systemd credentials, Docker/K8s secrets, etc.).

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development            # development | production | test
HOST=127.0.0.1                  # 0.0.0.0 inside containers
PORT=3000
LOG_LEVEL=info
# Reverse proxies whose X-Forwarded-For is trusted for client IPs (rate limiting).
# Comma-separated addresses/CIDRs or keywords: loopback, linklocal, uniquelocal.
# Hop counts are rejected (spoofable). Match the real topology:
#   local (no proxy):          TRUST_PROXY=false
#   Caddy/nginx on same host:  TRUST_PROXY=loopback
#   Docker published to host:  TRUST_PROXY=loopback   (compose.yaml sets this)
TRUST_PROXY=false

# --- URLs --------------------------------------------------------------------
# Public origin of the portal (https required in production).
APP_BASE_URL=http://localhost:3000
# Base used when generating short review links. Defaults to APP_BASE_URL + /r
# SHORT_LINK_BASE_URL=https://stlr.link
# If you point a dedicated short domain at this server, set its host so
# https://stlr.link/AbC123x works without the /r prefix.
# SHORT_LINK_HOST=stlr.link
SHORT_LINK_CODE_LENGTH=7
# Extra origins allowed to POST (comma separated). Rarely needed.
# ALLOWED_ORIGINS=
# Optional Vercel static frontend: public https origin of THIS backend. Used only
# by `npm run vercel-build` to rewrite /api and /healthz. The recommended
# production topology is Docker + Caddy on one origin (no Vercel).
# BACKEND_ORIGIN=https://reviews.stellardentalclinic.com

# --- Security ----------------------------------------------------------------
# REQUIRED in production: at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# Defaults to true in production. Only disable for plain-http local testing.
# COOKIE_SECURE=true
# Minimum time (ms) between loading a public form and submitting it (bot filter).
FORM_MIN_FILL_MS=2500
FORM_TOKEN_TTL_MINUTES=120

# --- Storage -----------------------------------------------------------------
DATABASE_PATH=data/portal.sqlite
STATIC_DIR=web/dist

# --- Google review destination (shown to every patient after submitting) -------
# Every patient is offered this Google review link with equal prominence; the
# private complaint form is always available as an extra choice. The sentiment
# verdict is used only for internal reporting and staff flags, never to decide
# who sees Google. Google provides no API to prefill or submit a review and no
# confirmation that one was posted; the portal copies the patient's text so they
# can paste it.
GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=ChIJfXYa4oPPXzkRD1P8S7a9swU
# Optional: the clinic's Google Place ID. When set, patients are sent straight
# to Google's "Write a review" dialog (https://search.google.com/local/writereview?placeid=...)
# instead of the share link. Find it in Business Profile (newReviewUrl) or the
# Place ID finder: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=ChIJfXYa4oPPXzkRD1P8S7a9swU

# --- C++ sentiment engine ----------------------------------------------------
SENTIMENT_ENABLED=true
SENTIMENT_BINARY=sentiment-engine/build/sentiment_server
SENTIMENT_MODEL_PATH=sentiment-engine/models/distilbert-sst2.onnx
SENTIMENT_VOCAB_PATH=sentiment-engine/models/vocab.txt
# Persistent worker processes (each loads the model once, ~560 MB RAM each).
SENTIMENT_WORKERS=1
SENTIMENT_TIMEOUT_MS=1000
SENTIMENT_STARTUP_TIMEOUT_MS=30000
SENTIMENT_MAX_QUEUE=100
# Model confidence below NEUTRAL is recorded as "neutral"; below UNCERTAIN (or
# when the engine's numbers are inconsistent) as "uncertain". UNCERTAIN < NEUTRAL.
SENTIMENT_NEUTRAL_THRESHOLD=0.75
SENTIMENT_UNCERTAIN_THRESHOLD=0.6
SENTIMENT_RETRY_INTERVAL_SECONDS=300

# --- Email notifications -----------------------------------------------------
# smtp (required in production) | console (logs metadata only) | disabled
# Production start-up calls SMTP verify() and refuses to listen if it fails.
# After filling SMTP_*: npm run build:app && npm run email:verify && npm run email:test
EMAIL_TRANSPORT=console
COMPLAINT_NOTIFY_TO=aaditya@migrationoverseas.com
# Must be an address your SMTP provider is authorised (SPF/DKIM) to send from.
EMAIL_FROM="Stellar Review Portal <no-reply@stellardentalclinic.com>"
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); false uses mandatory STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Include patient contact details and complaint text in the email body.
EMAIL_INCLUDE_DETAILS=true
EMAIL_MAX_ATTEMPTS=6
EMAIL_POLL_INTERVAL_SECONDS=30

# --- Data retention (days; 0 = keep until deleted manually) --------------------
RETENTION_REVIEWS_DAYS=0
RETENTION_COMPLAINTS_DAYS=0
