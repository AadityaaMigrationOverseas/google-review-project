# Reverse proxy with automatic HTTPS on a Linux VPS (not Bluehost shared hosting).
# The Node process MUST run with TRUST_PROXY=loopback so Fastify trusts Caddy's
# X-Forwarded-For and rate limits hash the real client IP, not 127.0.0.1.
reviews.stellardentalclinic.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

# Optional dedicated short-link domain (set SHORT_LINK_BASE_URL=https://stlr.link and SHORT_LINK_HOST=stlr.link).
